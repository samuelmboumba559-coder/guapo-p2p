def get_prix(trade_type):
    url = "https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search"
    data = json.dumps({
        "asset": "USDT",
        "fiat": "XAF",
        "page": 1,
        "rows": 1,
        "tradeType": trade_type,
        "payTypes": []
    }).encode()
    try:
        req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})
        with urllib.request.urlopen(req, timeout=10) as r:
            j = json.loads(r.read().decode())
            return float(j['data'][0]['adv']['price'])
    except:
        return 0

class GuapoLayout(BoxLayout):
    running = False
    def toggle(self):
        if not self.running:
            self.running = True
            self.ids.btn.text = "ARRETER"
            self.ids.btn.background_color = (0.8, 0, 0, 1)
            Clock.schedule_interval(self.update, 30)
            self.update(0)
        else:
            self.running = False
            self.ids.btn.text = "DEMARRER LE BOT"
            self.ids.btn.background_color = (0, 0.8, 0, 1)
            Clock.unschedule(self.update)

    def update(self, dt):
        v = get_prix("BUY")
        a = get_prix("SELL")
        self.ids.heure.text = f"Heure: {datetime.now().strftime('%H:%M:%S')}"
        if v == 0:
            self.ids.vendeur.text = "Pas de connexion..."
            return
        marge = a - v
        profit = (50000 / v) * marge if v > 0 else 0
        self.ids.vendeur.text = f"Vendeur: {v:.1f} XAF"
        self.ids.acheteur.text = f"Acheteur: {a:.1f} XAF"
        self.ids.profit.text = f"Profit 50k: {profit:.0f} XAF | Marge: {marge:.1f}"
        if v <= 598:
            self.ids.alerte.text = f"🔥 ACHETE MAINTENANT A {v} !"
        elif a >= 615:
            self.ids.alerte.text = f"💰 VENDS MAINTENANT A {a} !"
        else:
            self.ids.alerte.text = "En surveillance..."

class GuapoApp(App):
    def build(self):
        Builder.load_string(KV)
        return GuapoLayout()

GuapoApp().run()
